{
  "buildCommand": "pnpm --filter @workspace/community run build",
  "outputDirectory": "artifacts/community/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "BASE_PATH": "/",
    "NODE_ENV": "production"
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}

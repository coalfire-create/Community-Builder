# ============================================================
# Vercel 환경변수 설정 가이드
# 이 파일을 복사하여 .env.local 로 사용하거나,
# Vercel 대시보드 → Settings → Environment Variables 에 추가하세요.
# ============================================================

# 세션 서명 키 (랜덤 32자 이상 문자열 권장)
SESSION_SECRET=your-session-secret-here

# PostgreSQL 연결 문자열 (Neon, Supabase, PlanetScale 등)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Firebase Admin SDK 인증 정보
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# CORS 허용 도메인 (쉼표로 구분, 비어 있으면 전체 허용)
# 예: https://your-app.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=https://your-app.vercel.app
